# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).
# Every secret value in this file must stay empty: the pre-commit hook checks it.

# --- Supabase -------------------------------------------------------
# Local values: run `pnpm db:status` after `pnpm db:start`.
# Hosted values: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Public by design (protected by RLS). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS: never expose it to the browser. The app uses it
# only to call the public form's functions (src/lib/supabase/admin.ts, ADR
# 0010); the integration tests, to create fixture users. In Vercel: Sensitive.
SUPABASE_SECRET_KEY=

# --- Public application form ---------------------------------------
# Key of the HMAC that hashes candidates' IPs (at least 32 characters).
# Generate one with: openssl rand -hex 32. In Vercel: Sensitive.
IP_HASH_SECRET=

# --- Outgoing email (ADR 0011) ---------------------------------------
# resend (production and previews) | mailpit (local and CI) | disabled
EMAIL_PROVIDER=
# Sender, e.g. "rooms-platform <avisos@tu-dominio.es>". Without a verified
# domain, Resend only accepts onboarding@resend.dev, and only delivers to
# the email of the Resend account itself.
EMAIL_FROM=
# Resend API key (EMAIL_PROVIDER=resend). In Vercel: Sensitive.
RESEND_API_KEY=
# Mailpit of the local Supabase (EMAIL_PROVIDER=mailpit): http://127.0.0.1:54324
MAILPIT_URL=
